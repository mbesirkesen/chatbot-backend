# ============================================
# Yemek Tarifi Chatbot API - Ortam Değişkenleri
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# --------------------------------------------
# ZORUNLU AYARLAR
# --------------------------------------------

# PostgreSQL Veritabanı Bağlantısı
# Format: postgresql+asyncpg://kullanici:sifre@host:port/veritabani
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recipe_chatbot

# Google Gemini API Anahtarı
# https://aistudio.google.com/app/apikey adresinden alabilirsiniz
GEMINI_API_KEY=buraya-api-anahtarinizi-yazin

# --------------------------------------------
# OPSİYONEL AYARLAR (varsayılan değerler mevcut)
# --------------------------------------------

# Debug modu (varsayılan: False)
# DEBUG=True

# Log seviyesi: DEBUG, INFO, WARNING, ERROR (varsayılan: INFO)
# LOG_LEVEL=DEBUG

# Gemini model adı (varsayılan: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ChromaDB veri dizini (varsayılan: ./chroma_data)
# Türk mutfağı veri seti için: ./data/turkish_recipes_db
# CHROMA_PERSIST_DIR=./data/turkish_recipes_db

# ChromaDB koleksiyon adı (varsayılan: recipes)
# CHROMA_COLLECTION_NAME=recipes

# Embedding model adı (varsayılan: models/embedding-001)
# EMBEDDING_MODEL=models/embedding-001

# Önceden oluşturulmuş turkish_recipes için:
# EMBEDDING_PROVIDER=sentence_transformer
# EMBEDDING_MODEL_SENTENCE_TRANSFORMER=all-MiniLM-L6-v2
