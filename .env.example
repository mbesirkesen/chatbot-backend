# Uygulama Ayarları
APP_NAME=Yemek Tarifi Chatbot API
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL Veritabanı
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recipe_chatbot

# Google Gemini API
GEMINI_API_KEY=buraya-gemini-api-anahtarinizi-yazin
GEMINI_MODEL=gemini-2.0-flash

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=recipes

# Embedding Modeli
EMBEDDING_MODEL=models/embedding-001
